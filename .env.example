# Copy to .env and change what you need. Real environment variables win over this file.

# --- LLM (LM Studio, OpenAI-compatible API) ---
LM_BASE_URL=http://localhost:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=qwen3-4b-instruct-2507
LM_TEMPERATURE=0.3
LM_MAX_TOKENS=600
LM_MAX_TOOL_STEPS=6
# Extra request fields as JSON, e.g. for Gemma 4: {"reasoning_effort": "none"}
# LM_EXTRA_BODY=

# --- Speech recognition ---
STT_ENGINE=gigaam            # gigaam (fast, default) | whisper
STT_CPU_THREADS=4
STT_MIN_CHARS=3
# GIGAAM_MODEL_DIR=./models/sherpa-onnx-nemo-ctc-punct-giga-am-v3-russian-2025-12-16
WHISPER_MODEL=small          # only for STT_ENGINE=whisper

# --- Microphone / VAD ---
# AUDIO_INPUT_DEVICE=        # index or name from `python -m sounddevice`
# AUDIO_OUTPUT_DEVICE=
MIC_GAIN=2.0                 # quiet built-in mic: speech peaks ~0.1, so x2 helps VAD; lower if it clips
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=1000      # pause that ends a phrase; lower = faster answers, but cuts a thought in the middle
VAD_SPEECH_PAD_MS=300
VAD_MAX_UTTERANCE_S=60
TURN_PAUSE_S=2.4             # total silence before committing a normal request
TURN_INCOMPLETE_PAUSE_S=4.5  # extra patience for «я хочу», «чтобы», unfinished timer commands

# --- Voice ---
TTS_BACKEND=silero           # silero (local, ~0.15 s per phrase) | edge (online, nicer, but often slow: falls back to silero)
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_FIRST_CHUNK_TIMEOUT_S=2.5   # slower than this -> Silero
EDGE_TTS_RETRY_AFTER_S=60            # after a failure, stay on Silero this long
SILERO_MODEL=v5_5_ru
SILERO_SPEAKER=baya          # aidar, baya, kseniya, eugene, xenia
SILERO_SAMPLE_RATE=24000
TORCH_THREADS=4

# --- Wake word ---
WAKE_WORD=нора               # phrases without the name are ignored; empty = answer everything
WAKE_FOLLOWUP_S=15           # after an answer, talk on without the name for this long
BARGE_IN=1                   # listen while answering: «Нора, …», «стоп», «хватит» interrupt her
BARGE_ENGINE=auto            # auto = Vosk if installed + model exists, otherwise GigaAM; vosk | gigaam | off
# VOSK_MODEL_DIR=./models/vosk-model-small-ru-0.22

# --- Speaker/microphone processing (PipeWire / PulseAudio) ---
AEC_MODE=auto                # transient WebRTC echo cancellation: auto | on (required) | off
# AEC_SOURCE=                # physical Pulse source; empty = current default
# AEC_SINK=                  # physical Pulse sink; empty = current default
MUSIC_DUCK=1                 # lower playing MPRIS players during the conversation, restore afterwards
MUSIC_DUCK_FACTOR=0.35       # keep 35% of the player's volume; system volume unchanged

# --- Screen ---
INDICATOR=bottom             # status pill (listening / thinking / speaking): bottom | top | off

# --- App ---
ASSISTANT_PROFILE=nora       # nora | jarvis; --profile overrides this
# DB_PATH=./data/assistant.db
# TIMEZONE=Europe/Moscow     # default: system zone
# DEFAULT_CITY=Санкт-Петербург
HISTORY_MESSAGES=10
THINKING_CUES=1              # short waiting phrases during a slow foreground answer
THINKING_CUE_DELAY_S=4       # first phrase after 4 seconds; fast commands stay silent
THINKING_CUE_INTERVAL_S=14   # at most three cues per turn, never over other speech

# --- Coding agent (Codex by default) ---
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low

# --- Jarvis (separate identity, voice and database; Nora settings stay as they are) ---
JARVIS_WAKE_WORD=джарвиз
JARVIS_SILERO_SPEAKER=eugene # built-in male voice; alternative: aidar
JARVIS_EDGE_TTS_VOICE=ru-RU-DmitryNeural
# JARVIS_DB_PATH=./data/jarvis/assistant.db

# --- Skills/tools ---
TOOL_GROUPS=all              # or e.g. alarms,memory,media,weather,web,listening
DISABLED_TOOLS=              # comma-separated tool names, e.g. type_text,ask_coder
